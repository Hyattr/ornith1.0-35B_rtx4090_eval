# ============================================================
# このファイルは雛形です。実際のキーはここに書かないこと。
#   1. cp .env.example .env
#   2. .env に実際のキーを記入
# .env は .gitignore 済みなのでコミットされません。
# ============================================================

# --- 評価者(judge)用 ---

# Claude API : https://console.anthropic.com/settings/keys で発行
ANTHROPIC_API_KEY=

# Gemini API : https://aistudio.google.com/apikey で発行
GEMINI_API_KEY=

# --- 評価対象のローカルLLM ---

# LM Studio (OpenAI互換エンドポイント)。キーは任意の文字列でよい
LMSTUDIO_BASE_URL=http://127.0.0.1:1235/v1
LMSTUDIO_API_KEY=lm-studio
